# URL raiz do backend, sem /api no final.
VITE_API_URL=http://localhost:8000

# Identidade pública usada no HTML, compartilhamento social e PWA durante o build.
VITE_STORE_NAME="Maré de Nori Sushi"
VITE_STORE_BUSINESS_TYPE=restaurant
VITE_STORE_SHORT_NAME="Maré de Nori"
VITE_STORE_PAGE_TITLE="Maré de Nori Sushi | Cardápio e pedidos"
VITE_STORE_DESCRIPTION="Restaurante fictício de sushi para demonstrações e apresentações."
VITE_STORE_THEME_COLOR="#123C4A"
VITE_STORE_PRIMARY_COLOR="#C49347"
VITE_STORE_INK_COLOR="#152D35"
VITE_STORE_BACKGROUND_COLOR="#F7F4EC"
VITE_STORE_ICON=/logo.svg
VITE_STORE_ICON_SIZES=any
VITE_STORE_HERO_IMAGE=/hero.svg
VITE_STORE_OG_IMAGE=/og-preview.svg
