# Ambiente local. Depois de copiar este arquivo para .env, execute `php artisan key:generate`.
APP_NAME="Tong Sushi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
IGNITION_ENABLE_RUNNABLE_SOLUTIONS=false
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Frontend local (porta 3000 por padrao; 5173 tambem autorizada para Vite).
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
SANCTUM_TOKEN_PREFIX=
CORS_MAX_AGE=600

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=BD_TCC
DB_USERNAME=root
DB_PASSWORD=

# Administrador de desenvolvimento criado por `php artisan migrate --seed`.
# Estas credenciais sao apenas locais e devem ser trocadas antes de qualquer publicacao.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345678

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_COOKIE=restaurant_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="pedidos@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Loja de exemplo pronta para desenvolvimento local.
STORE_SLUG=tong-sushi
STORE_NAME="Tong Sushi"
STORE_SHORT_NAME="Tong Sushi"
STORE_BUSINESS_TYPE=restaurant
STORE_TAGLINE="Sabor e experiencia em cada pedido"
STORE_DESCRIPTION="Cardapio digital, pedidos e atendimento em uma experiencia premium."
STORE_LOGO_URL=/logo.svg
STORE_HERO_IMAGE_URL=/og-preview.jpg
STORE_PRIMARY_COLOR="#F48347"
STORE_SECONDARY_COLOR="#111111"
STORE_ACCENT_COLOR="#1B4332"
STORE_WHATSAPP=
STORE_PHONE=
STORE_EMAIL=
STORE_INSTAGRAM=
STORE_FACEBOOK=
STORE_ADDRESS="Rua Exemplo, 123 - Centro"
STORE_CITY="Ipero"
STORE_STATE=SP
STORE_POSTAL_CODE=18560-000
STORE_MAP_URL=
STORE_HOURS="Segunda a quinta|18h30 — 22h;Sexta e sábado|18h30 — 22h30;Domingo|Consulte o atendimento"
STORE_CURRENCY=BRL
STORE_LOCALE=pt-BR
STORE_TIMEZONE=America/Sao_Paulo
STORE_FEATURED_PRODUCT_IDS=

DELIVERY_ENABLED=true
DELIVERY_FEE=3.00
DELIVERY_ESTIMATE="40–90 min"
PICKUP_ENABLED=true
ORDER_MINIMUM=0.00
STORE_PAYMENT_METHODS="Pix,Cartão,Dinheiro"
