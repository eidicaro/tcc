# Produção: gere uma chave exclusiva com `php artisan key:generate`.
APP_NAME="Minha Loja"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
IGNITION_ENABLE_RUNNABLE_SOLUTIONS=false
APP_URL=https://api.example.com
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# URL completa do SPA e lista de origens confiáveis, separadas por vírgula.
FRONTEND_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com,api.example.com
SANCTUM_TOKEN_PREFIX=restaurant_
CORS_MAX_AGE=600

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_app
DB_USERNAME=restaurant_app
DB_PASSWORD=change-this-strong-password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_COOKIE=restaurant_session
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="pedidos@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# White-label do estabelecimento.
STORE_SLUG=minha-loja
STORE_NAME="Minha Loja"
STORE_SHORT_NAME="Minha Loja"
STORE_BUSINESS_TYPE=restaurant
STORE_TAGLINE="Sabor e experiência em cada pedido"
STORE_DESCRIPTION=""
STORE_LOGO_URL=
STORE_HERO_IMAGE_URL=
STORE_PRIMARY_COLOR="#F48347"
STORE_SECONDARY_COLOR="#111111"
STORE_ACCENT_COLOR="#1B4332"
STORE_WHATSAPP=
STORE_PHONE=
STORE_EMAIL=
STORE_INSTAGRAM=
STORE_FACEBOOK=
STORE_ADDRESS=
STORE_CITY=
STORE_STATE=
STORE_POSTAL_CODE=
STORE_MAP_URL=
STORE_HOURS="Segunda a quinta|18h30 — 22h;Sexta e sábado|18h30 — 22h30;Domingo|Consulte o atendimento"
STORE_CURRENCY=BRL
STORE_LOCALE=pt-BR
STORE_TIMEZONE=America/Sao_Paulo
STORE_FEATURED_PRODUCT_IDS=

DELIVERY_ENABLED=true
DELIVERY_FEE=3.00
DELIVERY_ESTIMATE="40–90 min"
PICKUP_ENABLED=true
ORDER_MINIMUM=0.00
STORE_PAYMENT_METHODS="Pix,Cartão,Dinheiro"
