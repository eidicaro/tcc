## Modelo de produção. Configure domínios, marca e credenciais antes de usar.
# Depois de copiar este arquivo para .env, execute `php artisan key:generate`.
APP_NAME="Sua Loja"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
IGNITION_ENABLE_RUNNABLE_SOLUTIONS=false
APP_URL=https://api.sualoja.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Frontend local (porta 3000 por padrao; 5173 tambem autorizada para Vite).
FRONTEND_URL=https://app.sualoja.com.br
ALLOWED_ORIGINS=https://app.sualoja.com.br
SANCTUM_STATEFUL_DOMAINS=app.sualoja.com.br,api.sualoja.com.br
SANCTUM_TOKEN_PREFIX=
CORS_MAX_AGE=600

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loja
DB_USERNAME=loja_app
DB_PASSWORD=CHANGE_ME

# Administrador de desenvolvimento criado por `php artisan migrate --seed`.
# Estas credenciais sao apenas locais e devem ser trocadas antes de qualquer publicacao.

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_COOKIE=loja_session
SESSION_DOMAIN=.sualoja.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="pedidos@sualoja.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Loja de exemplo pronta para desenvolvimento local.
STORE_SLUG=sua-loja
STORE_NAME="Sua Loja"
STORE_SHORT_NAME="Sua Loja"
STORE_BUSINESS_TYPE=retail
STORE_TAGLINE="Sua loja perto de você"
STORE_DESCRIPTION="Produtos e entrega com praticidade."
STORE_LOGO_URL=/brand/logo.svg
STORE_HERO_IMAGE_URL=/brand/hero.svg
STORE_PRIMARY_COLOR="#C49347"
STORE_SECONDARY_COLOR="#152D35"
STORE_ACCENT_COLOR="#123C4A"
STORE_WHATSAPP=
STORE_PHONE=
STORE_EMAIL=
STORE_INSTAGRAM=
STORE_FACEBOOK=
STORE_ADDRESS="Rua da Loja, 123"
STORE_CITY="Sua cidade"
STORE_STATE=SP
STORE_POSTAL_CODE=
STORE_MAP_URL=
STORE_HOURS="Segunda a quinta|18h30 — 22h;Sexta e sábado|18h30 — 22h30;Domingo|Consulte o atendimento"
STORE_CURRENCY=BRL
STORE_LOCALE=pt-BR
STORE_TIMEZONE=America/Sao_Paulo
STORE_FEATURED_PRODUCT_IDS=

DELIVERY_ENABLED=true
DELIVERY_FEE=3.00
DELIVERY_ESTIMATE="40–90 min"
PICKUP_ENABLED=true
ORDER_MINIMUM=0.00
STORE_PAYMENT_METHODS="Pix,Cartão,Dinheiro"
